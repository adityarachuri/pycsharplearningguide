{
  "name": "pycsharp",
  "version": "1.0.0",
  "description": "PyCSharp: Polyglot Systems & Technical Rosetta Stone - Learning Python from a C# developer's perspective",
  "license": "MIT",
  "homepage": "https://github.com/adityarachuri/pycsharplearningguide#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/adityarachuri/pycsharplearningguide.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test": "npm run lint && npm run test:coverage && npm run build",
    "docs:generate": "node scripts/generate-docs.mjs",
    "generate:icons": "node scripts/generate-pwa-icons.cjs",
    "postinstall": "node scripts/copy-pyodide-runtime.mjs",
    "predev": "node scripts/copy-pyodide-runtime.mjs",
    "prebuild": "node scripts/copy-pyodide-runtime.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "mermaid": "^12.3.0",
    "pyodide": "^314.0.7",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
